{
  "openapi": "3.1.0",
  "info": {
    "title": "Product catalog",
    "version": "2026.09",
    "description": "Stock reads and quotes use its SQLite store. Availability is a quote, not a reservation. Requests exactly equal to available stock should be accepted. Adjustments cannot make the resulting stock negative. Supply Operations owns this interface."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5005"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/v1/products": {
      "get": {
        "summary": "Product catalog",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sku": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "price_minor": {
                        "type": "integer"
                      },
                      "stock_on_hand": {
                        "type": "integer"
                      },
                      "location": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "sku",
                      "name",
                      "price_minor",
                      "stock_on_hand",
                      "location"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/v1/availability": {
      "post": {
        "summary": "Quote requested stock",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "available": {
                      "type": "boolean"
                    },
                    "total_minor": {
                      "type": "integer"
                    },
                    "currency": {
                      "const": "USD"
                    }
                  },
                  "required": [
                    "available",
                    "total_minor",
                    "currency"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "required": [
                        "sku",
                        "quantity"
                      ],
                      "properties": {
                        "sku": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  }
                },
                "required": [
                  "items"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/products/{sku}/adjustments": {
      "post": {
        "summary": "Adjust available stock",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sku": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "price_minor": {
                      "type": "integer"
                    },
                    "stock_on_hand": {
                      "type": "integer"
                    },
                    "location": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "sku",
                    "name",
                    "price_minor",
                    "stock_on_hand",
                    "location"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        },
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "delta": {
                    "type": "integer"
                  }
                },
                "required": [
                  "delta"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
