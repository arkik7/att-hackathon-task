{
  "openapi": "3.1.0",
  "info": {
    "title": "Create simulated charge",
    "version": "2026.09",
    "description": "Charge Ledger accepts an Idempotency-Key header. Repeating the same key and request body MUST return the original charge identifier and MUST NOT create another charge. Conflicting reuse should return 409. The simulator records provider.name=ledger-sim and performs no network settlement."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5004"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/v1/charges": {
      "post": {
        "summary": "Create simulated charge",
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "order_id": {
                      "type": "string"
                    },
                    "amount_minor": {
                      "type": "integer"
                    },
                    "currency": {
                      "const": "USD"
                    },
                    "status": {
                      "enum": [
                        "succeeded",
                        "declined"
                      ]
                    },
                    "idempotency_key": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "provider": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "reference": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "reference"
                      ]
                    },
                    "created_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "order_id",
                    "amount_minor",
                    "currency",
                    "status",
                    "idempotency_key",
                    "provider",
                    "created_at"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string"
                  },
                  "amount_minor": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "currency": {
                    "const": "USD"
                  },
                  "payment_token": {
                    "type": "string",
                    "pattern": "^tok_demo_"
                  }
                },
                "required": [
                  "order_id",
                  "amount_minor",
                  "currency",
                  "payment_token"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Same key and body returns the original charge. Conflicting body returns 409.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/charges/{id}": {
      "get": {
        "summary": "Charge lookup",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "order_id": {
                      "type": "string"
                    },
                    "amount_minor": {
                      "type": "integer"
                    },
                    "currency": {
                      "const": "USD"
                    },
                    "status": {
                      "enum": [
                        "succeeded",
                        "declined"
                      ]
                    },
                    "idempotency_key": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "provider": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "reference": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "reference"
                      ]
                    },
                    "created_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "order_id",
                    "amount_minor",
                    "currency",
                    "status",
                    "idempotency_key",
                    "provider",
                    "created_at"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
