{
  "openapi": "3.1.0",
  "info": {
    "title": "GraphQL query",
    "version": "2026.09",
    "description": "Edge exposes REST forwarding and a small GraphQL query surface. products reads inventory, customer reads Accounts, and order enriches an Orders response with customer and charge fields. This schema does not provide subscriptions or HR mutations."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5001"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/graphql": {
      "post": {
        "summary": "Query products, customer, or enriched order",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "variables": {
                    "type": "object"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/products": {
      "get": {
        "summary": "Products",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sku": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "price_minor": {
                        "type": "integer"
                      },
                      "stock_on_hand": {
                        "type": "integer"
                      },
                      "location": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "sku",
                      "name",
                      "price_minor",
                      "stock_on_hand",
                      "location"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/v2/users/{id}": {
      "get": {
        "summary": "Customer",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "display_name": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "account_status": {
                      "enum": [
                        "active",
                        "suspended"
                      ]
                    },
                    "customer_tier": {
                      "enum": [
                        "standard",
                        "business"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "display_name",
                    "email",
                    "account_status",
                    "customer_tier"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/orders": {
      "get": {
        "summary": "Orders",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "customer_id": {
                        "type": "string"
                      },
                      "total_minor": {
                        "type": "integer"
                      },
                      "status": {
                        "enum": [
                          "confirmed",
                          "declined"
                        ]
                      },
                      "charge_id": {
                        "type": "string"
                      },
                      "created_at": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "customer_id",
                      "total_minor",
                      "status",
                      "charge_id",
                      "created_at"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        }
      },
      "post": {
        "summary": "Checkout",
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "customer_id": {
                      "type": "string"
                    },
                    "total_minor": {
                      "type": "integer"
                    },
                    "status": {
                      "enum": [
                        "confirmed",
                        "declined"
                      ]
                    },
                    "charge_id": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "customer_id",
                    "total_minor",
                    "status",
                    "charge_id",
                    "created_at"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/v1/orders/{id}": {
      "get": {
        "summary": "Order",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "customer_id": {
                      "type": "string"
                    },
                    "total_minor": {
                      "type": "integer"
                    },
                    "status": {
                      "enum": [
                        "confirmed",
                        "declined"
                      ]
                    },
                    "charge_id": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "customer_id",
                    "total_minor",
                    "status",
                    "charge_id",
                    "created_at"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Dependency unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
