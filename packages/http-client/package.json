    "test": "node --import tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/express": "5.0.6",
    "@types/cors": "2.8.19",
    "eslint": "9.39.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "tsx": "4.23.13",
    "tsdown": "0.23.0"
  },
  "files": [
    "dist",
    "src"
  ]
